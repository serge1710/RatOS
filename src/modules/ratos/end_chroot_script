#!/usr/bin/env bash
# Installs RatOS
# GPL V3
########


# Source error handling, leave this in place
set -xe

# Service configuration must run as root: setuid sudo cannot escalate in
# the image's nosuid chroot. Keep extension symlinking under the target user.
if [[ -f /usr/lib/systemd/system/ModemManager.service ||
      -f /lib/systemd/system/ModemManager.service ||
      -f /etc/systemd/system/ModemManager.service ]]; then
    systemctl disable ModemManager.service
fi
systemctl mask ModemManager.service

KS_SERVICE=/etc/systemd/system/KlipperScreen.service
if [[ -f "${KS_SERVICE}" ]]; then
    sed -i -e 's/^RestartSec=1$/RestartSec=5/' \
        -e 's/^StartLimitIntervalSec=0$/StartLimitIntervalSec=100\nStartLimitBurst=4/' \
        "${KS_SERVICE}"
fi

POST_INSTALL="/home/${BASE_USER}/printer_data/config/RatOS/scripts/ratos-post-install.sh"
POST_BUILD="$(mktemp "$(dirname "${POST_INSTALL}")/.ratos-post-build.XXXXXX.sh")"
# Skip only the two privileged calls already handled above, preserving the
# upstream user guard and symlink_extensions failure handling.
sed -e '/^disable_modem_manager[[:space:]]*$/d' \
    -e '/^patch_klipperscreen_service_restarts[[:space:]]*$/d' \
    "${POST_INSTALL}" > "${POST_BUILD}"
bash -n "${POST_BUILD}"
chmod 0644 "${POST_BUILD}"
if sudo -u "${BASE_USER}" env HOME="/home/${BASE_USER}" \
    USER="${BASE_USER}" LOGNAME="${BASE_USER}" bash "${POST_BUILD}"; then
    rm -f "${POST_BUILD}"
else
    POST_STATUS=$?
    rm -f "${POST_BUILD}"
    exit "${POST_STATUS}"
fi

# Stop the configurator, curl will fail so disable exit on error
set +e
echo "Stopping the configurator"
curl 'http://localhost:3000/configure/api/trpc/kill' &> /dev/null
# Re-enable exit on error
set -e

retries=0
while [ "$(pgrep -f -c "ratos-configurator")" -gt 0 ]; do
    if [ $retries -gt 10 ]; then
        echo "Configurator did not stop, killing it..."
        pkill -f "ratos-configurator"
        if [ $retries -gt 12 ]; then
            echo "Configurator cannot be killed.. :("
            break
        fi
    fi
    echo "Waiting for configurator to stop... ${retries}s passed"
    sleep 1
    retries=$((retries + 1))
done

echo "Configurator stopped.."

if [ "$(pgrep -f -c "KlipperScreen")" -gt 0 ]; then
    echo "Stopping KlipperScreen"
    retries=0
    while [ "$(pgrep -f -c "KlipperScreen")" -gt 0 ]; do
        if [ $retries -gt 10 ]; then
            echo "KlipperScreen did not stop, killing it..."
            pkill -f "KlipperScreen"
            if [ $retries -gt 12 ]; then
                echo "KlipperScreen cannot be killed.. :("
                break
            fi
        fi
        echo "Waiting for KlipperScreen to stop... ${retries}s passed"
        sleep 1
        retries=$((retries + 1))
    done
fi

echo "List out all running processes"
ps aux