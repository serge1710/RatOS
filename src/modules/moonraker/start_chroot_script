# shellcheck enable=require-variable-braces

# Source error handling, leave this in place
set -Ee

# Source CustomPIOS common.sh
# shellcheck disable=SC1091
source /common.sh
install_cleanup_trap

# Module only Variables
MN_BUILD_INSTALL_SH="/home/${BASE_USER}/moonraker/scripts/install-moonraker.sh"

echo_green "Installing Moonraker and enable Moonraker Service ..."

## Force apt update
apt-get update
## Make sure 'git' is installed!
check_install_pkgs git

## Step 1: Move to Home Dir as WorkingDirectoy
pushd "/home/${BASE_USER}" &> /dev/null || exit 1

## Step 2: clone moonraker repo
gitclone MOONRAKER_REPO moonraker

# The current upstream installer detects distro-specific dependencies itself.
# Do not extract PACKAGES assignments: dependency detection now uses Python.

## Step 7: Move to moonraker as working directory
pushd "/home/${BASE_USER}/moonraker" &> /dev/null || exit 1

## Step 8: Run moonraker install routine
echo_green "Launch moonraker install routine ..."
# QEMU user emulation cannot reliably elevate a non-root process through
# setuid sudo. Execute privileged installation from the root build chroot.
# Keep USER/HOME set to the target account so the service and paths stay correct.
[[ "${EUID}" -eq 0 ]] || { echo_red "Moonraker image installation requires root"; exit 1; }
grep -qx 'verify_ready' "${MN_BUILD_INSTALL_SH}"
MN_CHROOT_INSTALL_SH="$(mktemp ./scripts/.ratos-install.XXXXXX.sh)"
# Remove only the top-level non-root guard call from a temporary installer.
# Keep its directory unchanged: upstream derives SRCDIR from BASH_SOURCE.
sed '/^verify_ready$/d' "${MN_BUILD_INSTALL_SH}" > "${MN_CHROOT_INSTALL_SH}"
if env HOME="/home/${BASE_USER}" USER="${BASE_USER}" LOGNAME="${BASE_USER}" \
    bash "${MN_CHROOT_INSTALL_SH}" -z -x -s; then
    rm -f "${MN_CHROOT_INSTALL_SH}"
else
    MN_INSTALL_STATUS=$?
    rm -f "${MN_CHROOT_INSTALL_SH}"
    exit "${MN_INSTALL_STATUS}"
fi
chown -R "${BASE_USER}:${BASE_USER}" \
    "/home/${BASE_USER}/moonraker" "/home/${BASE_USER}/moonraker-env" \
    "/home/${BASE_USER}/printer_data"
if [[ -d "/home/${BASE_USER}/.cache" ]]; then
    chown -R "${BASE_USER}:${BASE_USER}" "/home/${BASE_USER}/.cache"
fi

## Step 9: Install policykit rules
echo_green "Install moonrakers PolicyKit Rules ..."
env HOME="/home/${BASE_USER}" USER="${BASE_USER}" LOGNAME="${BASE_USER}" \
    bash ./scripts/set-policykit-rules.sh --root --disable-systemctl

## Step 10: Leave moonraker
popd &> /dev/null || exit 1


## Step 12: leave home dir
popd &> /dev/null || exit 1

## Step 13: Install RatOS premade moonraker.conf
echo_green "Copying RatOS premade moonraker.conf ..."
unpack /filesystem/home/"${BASE_USER}" /home/"${BASE_USER}" "${BASE_USER}"

## Step 14:
echo_green "Enable moonraker.service ..."
systemctl_if_exists enable moonraker.service

## Finish
echo_green "Installing Moonraker and enable Moonraker Service ... DONE!"
