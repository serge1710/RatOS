#!/bin/bash
set -euo pipefail
source /common.sh
source /files/00-config
# Fail the image build if a later installer introduces a CAN interface.
if find /etc/network/interfaces.d /etc/systemd/network -maxdepth 1 -type f -iname '*can*' 2>/dev/null | grep -q .; then
    echo "Unexpected CAN network configuration in USB-only image" >&2
    exit 1
fi
if dpkg-query -W -f='${Status}' can-utils 2>/dev/null | grep -q 'install ok installed'; then
    echo "Unexpected can-utils in USB-only image" >&2
    exit 1
fi
if grep -Eq '^[[:space:]]*dtoverlay=.*(mcp251|can)' "${BOOT_PATH}/config.txt"; then
    echo "Unexpected CAN overlay in USB-only image" >&2
    exit 1
fi
printf '%s\n' 'USB MCU only; Manta M8P v2.0' > /etc/ratos-mcu-transport
