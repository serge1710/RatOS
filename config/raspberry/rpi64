#!/usr/bin/env bash
# CustomPiOS 2.0 discovers the current Raspberry Pi OS Lite image.
# The downloader rejects releases outside Trixie ARM64.
BASE_BOARD="raspberrypiarm64"
BASE_ARCH="arm64"
BASE_OS="debian_trixie"
BASE_IMAGE_PATH="${DIST_PATH}/image/trixie-arm64"

export BASE_BOARD
export BASE_ARCH
export BASE_OS
export BASE_IMAGE_PATH
